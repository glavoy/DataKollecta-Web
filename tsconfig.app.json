{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    /* `strict` is on, which subsumes noImplicitAny and strictNullChecks.
       Turning it on found the failure this project had already been warned
       about: `manifest.crfs` is optional, and the code that iterated it was
       in a different function from the check that it exists -- so a package
       whose manifest failed to parse typechecked fine and threw in the
       designer at runtime. Note that `npm run build` does NOT typecheck (Vite
       + SWC strip types without checking them), so `tsc --noEmit` has to be
       run separately -- see the README's Verification section. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
